# runtime control files: read mid-run to steer a batch (e.g. eval_asvld.py
# re-reads .asvld_skip per condition), so their contents are per-run state
# rather than something to version.
.asvld_skip

# Generated score-file artifacts. The release manifest IS tracked; the trial
# lists and subsamples that an earlier design shipped are not -- they are
# recomputable from the score files and must not be duplicated into git.
/trials/
/reference/*
!/reference/manifest.json
# The level-2 reference: the six analysis tables verification grades against,
# plus their provenance. Tens of KB, and unlike the score files they ARE the
# artefact a reproduction is compared to -- so they are versioned, and a change
# to any of them shows up in review.
!/reference/analysis/
!/reference/analysis/**
# `*.json` above is a global rule and would swallow provenance.json, which is
# the record of WHICH tree and WHICH commit these tables came from -- the part
# that makes them a reference rather than six loose CSVs.
!/reference/analysis/provenance.json
